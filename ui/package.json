{
  "name": "snore-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint-check": "eslint . --max-warnings 0",
    "lint": "eslint . --fix",
    "format-check": "prettier --check 'src/**/*.{ts,vue,json,css}'",
    "format": "prettier --write 'src/**/*.{ts,vue,json,css}'"
  },
  "dependencies": {
    "@primevue/themes": "^4.0.0",
    "axios": "^1.16.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "uplot": "^1.6.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vue-tsc": "^3.2.8"
  }
}
