{
  "name": "snore-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint-check": "eslint . --max-warnings 0",
    "lint": "eslint . --fix",
    "format-check": "prettier --check 'src/**/*.{ts,vue,json,css}' 'tests/**/*.ts' '*.spec.ts'",
    "format": "prettier --write 'src/**/*.{ts,vue,json,css}' 'tests/**/*.ts' '*.spec.ts'",
    "generate:types": "openapi-typescript openapi.json --output src/types/generated.ts && prettier --write src/types/generated.ts",
    "test:screenshot": "playwright test screenshot.spec.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.21.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.1",
    "typescript": "catalog:",
    "vite": "^8.0.11",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.8"
  }
}
